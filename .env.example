# Copy to .env for local development. Never commit .env.
# Full reference: docs/env.md

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=placement
POSTGRES_USER=placement
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://placement:change-me@db:5432/placement

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Resume storage (S3-compatible; SeaweedFS in docker compose). Generate your own keys.
RESUME_S3_ACCESS_KEY=change-me-access-key
RESUME_S3_SECRET_KEY=change-me-secret-key
RESUME_S3_BUCKET=resumes
RESUME_S3_ENDPOINT_URL=http://objectstore:8333
RESUME_S3_PUBLIC_URL=http://localhost:8333

# Optional: raises GitHub's API limit for coding-activity sync (60 requests/hour without it).
GITHUB_TOKEN=

# Origins the browser uses for the app (the Next.js frontend). Required for CSRF on POST/PATCH/DELETE.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional (see docs/env.md): THROTTLE_LOGIN, MFA_REQUIRED_ROLES, PROFILE_RECOMPUTE_DEBOUNCE_SECONDS,
# NOTIFICATION_EMAIL_KINDS, EMAIL_BACKEND, DEFAULT_FROM_EMAIL
LOG_LEVEL=INFO
