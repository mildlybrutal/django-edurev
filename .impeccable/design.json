  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action; cobalt fill, press scale.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Save changes</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;font-size:0.875rem;font-weight:500;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;border:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),opacity 150ms cubic-bezier(0.22,1,0.36,1),transform 150ms cubic-bezier(0.22,1,0.36,1);} .ds-btn:active{transform:scale(0.97);} .ds-btn:focus-visible{outline:2px solid var(--focus,#1e3fae);outline-offset:2px;} .ds-btn-primary{background:var(--primary,#1e3fae);color:var(--primary-foreground,#fff);} .ds-btn-primary:hover{background:var(--primary-hover,#18348f);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered surface button for secondary actions.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;font-size:0.875rem;font-weight:500;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;border:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),opacity 150ms cubic-bezier(0.22,1,0.36,1),transform 150ms cubic-bezier(0.22,1,0.36,1);} .ds-btn:active{transform:scale(0.97);} .ds-btn:focus-visible{outline:2px solid var(--focus,#1e3fae);outline-offset:2px;} .ds-btn-secondary{background:var(--surface,#fff);color:var(--foreground,#0f1a33);border:1px solid var(--border,#dde2ec);} .ds-btn-secondary:hover{background:var(--surface-muted,#eef1f7);border-color:var(--border-strong,#c4cbdb);}"
    },
    {
      "name": "Next Button",
      "kind": "button",
      "refersTo": "button-next",
      "description": "Reserved violet; only the single next action.",
      "html": "<button class=\"ds-btn ds-btn-next\">Start this task</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;font-size:0.875rem;font-weight:500;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;border:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),border-color 150ms cubic-bezier(0.22,1,0.36,1),opacity 150ms cubic-bezier(0.22,1,0.36,1),transform 150ms cubic-bezier(0.22,1,0.36,1);} .ds-btn:active{transform:scale(0.97);} .ds-btn:focus-visible{outline:2px solid var(--focus,#1e3fae);outline-offset:2px;} .ds-btn-next{background:var(--next,#6d28d9);color:var(--next-foreground,#fff);} .ds-btn-next:hover{opacity:0.9;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above a 36px bordered input; border turns cobalt on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">CGPA</span><input class=\"ds-input\" placeholder=\"8.2\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;} .ds-field-label{font-size:0.875rem;font-weight:500;color:var(--foreground,#0f1a33);} .ds-input{height:36px;padding:0 12px;border-radius:6px;border:1px solid var(--border,#dde2ec);background:var(--surface,#fff);color:var(--foreground,#0f1a33);font-size:0.875rem;font-variant-numeric:tabular-nums;transition:border-color 150ms;} .ds-input::placeholder{color:var(--muted,#4b5671);} .ds-input:hover{border-color:var(--border-strong,#c4cbdb);} .ds-input:focus{border-color:var(--primary,#1e3fae);outline:2px solid var(--focus,#1e3fae);outline-offset:2px;}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Committed cobalt rail with a white active pill.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav ds-nav-active\" href=\"#\">Dashboard</a><a class=\"ds-nav\" href=\"#\">Skills &amp; Evidence</a><a class=\"ds-nav\" href=\"#\">Placement Drives</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:232px;padding:12px;background:var(--rail,#1e3fae);font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;} .ds-nav{display:block;padding:8px 12px;border-radius:6px;font-size:0.875rem;color:var(--rail-muted,#d3ddfa);text-decoration:none;transition:background-color 150ms cubic-bezier(0.22,1,0.36,1),color 150ms;} .ds-nav:hover{background:var(--rail-hover,#2a4cbd);color:#fff;} .ds-nav-active,.ds-nav-active:hover{background:#fff;color:var(--rail-active-foreground,#1e3fae);font-weight:500;} .ds-nav:focus-visible{outline:2px solid #fff;outline-offset:2px;}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Pill with icon plus label; never colour alone.",
      "html": "<span class=\"ds-badge ds-badge-success\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>Verified</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:9999px;font-size:0.75rem;font-weight:500;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;} .ds-badge-success{background:var(--success-soft,#e3f4eb);color:var(--success,#127347);}"
    },
    {
      "name": "Cluster Chip",
      "kind": "chip",
      "refersTo": "cluster-chip",
      "description": "Cluster soft wash, solid swatch, cluster name.",
      "html": "<span class=\"ds-chip\"><span class=\"ds-chip-swatch\"></span>Databases</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:2px 6px;border-radius:4px;font-size:0.75rem;font-weight:500;background:var(--mod-teal-soft,#e0f2f3);color:var(--mod-teal,#0e7c86);font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;} .ds-chip-swatch{width:8px;height:8px;border-radius:2px;background:var(--mod-teal,#0e7c86);}"
    },
    {
      "name": "KPI Stat Tile",
      "kind": "card",
      "refersTo": "stat-tile",
      "description": "Bordered tile with a 4px module-hue band on top and a tabular value.",
      "html": "<div class=\"ds-stat\"><span class=\"ds-stat-band\"></span><p class=\"ds-stat-label\">Verified evidence</p><p class=\"ds-stat-value\">18 / 22</p><p class=\"ds-stat-hint\">Verified by your mentor or the institution</p></div>",
      "css": ".ds-stat{position:relative;overflow:hidden;width:240px;padding:20px 20px 16px;border:1px solid var(--border,#dde2ec);border-radius:8px;background:var(--surface,#fff);color:var(--foreground,#0f1a33);font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;} .ds-stat-band{position:absolute;left:0;right:0;top:0;height:4px;background:var(--mod-teal,#0e7c86);} .ds-stat-label{margin:0;font-size:0.875rem;color:var(--muted,#4b5671);} .ds-stat-value{margin:6px 0 0;font-size:1.75rem;line-height:1;font-weight:600;letter-spacing:-0.025em;font-variant-numeric:tabular-nums;} .ds-stat-hint{margin:8px 0 0;font-size:0.75rem;color:var(--muted,#4b5671);}"
    },
    {
      "name": "Module Row",
      "kind": "custom",
      "refersTo": "module-row",
      "description": "Signature: numbered 44px spine in the cluster hue; the next row gets a violet border and NEXT tag.",
      "html": "<div class=\"ds-mod ds-mod-next\"><div class=\"ds-mod-spine\">01</div><div class=\"ds-mod-body\"><strong>Learn Docker fundamentals</strong> <span class=\"ds-next-tag\">Next</span><div class=\"ds-mod-due\">Due 2026-10-26</div></div></div><div class=\"ds-mod\"><div class=\"ds-mod-spine ds-mod-crimson\">02</div><div class=\"ds-mod-body\"><strong>System design practice</strong><div class=\"ds-mod-due\">Due 2026-11-09</div></div></div>",
      "css": ".ds-mod{display:flex;align-items:stretch;overflow:hidden;width:420px;margin-bottom:8px;border:1px solid var(--border,#dde2ec);border-radius:8px;background:var(--surface,#fff);color:var(--foreground,#0f1a33);font-size:0.875rem;font-family: var(--font-geist-sans, Geist), ui-sans-serif, system-ui, sans-serif;transition:border-color 150ms cubic-bezier(0.22,1,0.36,1);} .ds-mod:hover{border-color:var(--border-strong,#c4cbdb);} .ds-mod-next,.ds-mod-next:hover{border-color:var(--next,#6d28d9);} .ds-mod-spine{display:flex;align-items:center;justify-content:center;width:44px;flex-shrink:0;font-weight:600;font-variant-numeric:tabular-nums;background:var(--mod-marigold,#e8a317);color:var(--mod-ink-dark,#1f1500);} .ds-mod-crimson{background:var(--mod-crimson,#c2362b);color:var(--mod-ink-light,#fff);} .ds-mod-body{flex:1;padding:12px 16px;} .ds-mod-due{margin-top:2px;font-size:0.75rem;color:var(--muted,#4b5671);font-variant-numeric:tabular-nums;} .ds-next-tag{display:inline-flex;margin-left:6px;padding:2px 6px;border-radius:4px;background:var(--next,#6d28d9);color:var(--next-foreground,#fff);font-size:11px;font-weight:600;letter-spacing:0.025em;text-transform:uppercase;}"
    },
    {
      "name": "Meter",
      "kind": "custom",
      "refersTo": "meter",
      "description": "8px pill track; fill grows from the left on mount.",
      "html": "<div class=\"ds-meter\" role=\"meter\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"Django\"><div class=\"ds-meter-fill\" style=\"width:70%\"></div></div>",
      "css": "@keyframes ds-meter-grow{from{transform:scaleX(0);}} .ds-meter{width:280px;height:8px;overflow:hidden;border-radius:9999px;background:var(--series-track,#dbe4fb);} .ds-meter-fill{height:100%;border-radius:9999px;background:var(--series-1,#2a55d6);transform-origin:left;animation:ds-meter-grow 220ms cubic-bezier(0.22,1,0.36,1);} @media (prefers-reduced-motion: reduce){.ds-meter-fill{animation:none;}}"
